# Copy to .env and fill in. Never commit .env.

# --- LLM ---
# Which provider the agent planner/extractor uses: openai | anthropic | null
WEBFLOW_LLM__PROVIDER=openai
WEBFLOW_LLM__MODEL=gpt-4o-mini
WEBFLOW_LLM__API_KEY=sk-...
# Optional, for Azure/OpenAI-compatible gateways
# WEBFLOW_LLM__BASE_URL=https://api.openai.com/v1

# --- Browser ---
WEBFLOW_BROWSER__HEADLESS=true
WEBFLOW_BROWSER__SLOW_MO_MS=0
WEBFLOW_BROWSER__LOCALE=da-DK
WEBFLOW_BROWSER__TIMEZONE=Europe/Copenhagen

# --- Agent budget ---
WEBFLOW_AGENT__MAX_STEPS=60
WEBFLOW_AGENT__MAX_LLM_CALLS=80

# --- Storage ---
WEBFLOW_DATA_DIR=data
WEBFLOW_LOG_LEVEL=INFO
WEBFLOW_LOG_JSON=false
